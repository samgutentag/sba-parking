{
  "name": "sba-parking",
  "version": "0.1.0",
  "private": true,
  "description": "Tracks Santa Barbara Airport parking lot availability over time",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/main.ts",
    "poll": "node --disable-warning=ExperimentalWarning src/poll-once.ts",
    "poll:flights": "node --disable-warning=ExperimentalWarning src/flights-poll-once.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --test-scheduled",
    "worker:deploy": "wrangler deploy",
    "worker:rebuild-rollup": "node --disable-warning=ExperimentalWarning src/print-sql.ts rebuildRollup > .wrangler/rebuild-rollup.sql && wrangler d1 execute sba-parking --remote --file .wrangler/rebuild-rollup.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "wrangler": "4.168.0"
  }
}
