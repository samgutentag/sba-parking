[Unit]
Description=SBA parking availability tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/sba-parking
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/main.ts
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3210
# Loopback only: the Cloudflare Tunnel reaches it on localhost, nothing else on the LAN needs to.
Environment=HOST=127.0.0.1
Environment=DB_PATH=/opt/sba-parking/data/parking.db
Environment=USER_AGENT=sba-parking-tracker/0.1 (+mailto:you@example.com)
Environment=POLL_FLIGHTS=1
Environment=FLIGHTS_POLL_INTERVAL_MS=900000

[Install]
WantedBy=multi-user.target
