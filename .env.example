# All optional. Defaults shown.
PORT=3210
HOST=127.0.0.1
DB_PATH=./data/parking.db
POLL_INTERVAL_MS=300000
MAX_BACKOFF_MS=3600000
# Identify yourself to the .gov upstream. Add a contact address.
USER_AGENT="sba-parking-tracker/0.1 (+mailto:you@example.com)"
# Set POLL=0 to serve the web page without polling (for example, a read-only copy of the DB).
POLL=1

# Flight schedule feed (experimental, separate poller). Same USER_AGENT is sent to it.
FLIGHTS_POLL_INTERVAL_MS=900000
# Set POLL_FLIGHTS=0 to disable the flights poller without touching the parking one.
POLL_FLIGHTS=1
